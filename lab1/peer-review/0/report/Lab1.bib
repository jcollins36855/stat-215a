
@article{kuppermann_identification_2009,
  title    = {Identification of children at very low risk of clinically-important brain injuries after head trauma: a prospective cohort study},
  abstract = {Background CT imaging of head-injured children has risks of radiation-induced malignancy. Our aim was to identify children at very low risk of clinically-important traumatic brain injuries (ciTBI) for whom CT might be unnecessary.},
